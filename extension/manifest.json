{
  "manifest_version": 3,
  "name": "Diao",
  "version": "0.9.0",
  "description": "让新开的链接留在同一组。网页任务在标签旁提醒，ChatGPT 支持原位批注、排队和会话概览。",
  "minimum_chrome_version": "120",
  "key": "",
  "permissions": [
    "tabs",
    "favicon",
    "storage",
    "sidePanel",
    "scripting",
    "activeTab",
    "alarms",
    "nativeMessaging",
    "tabGroups",
    "contextMenus"
  ],
  "optional_host_permissions": [
    "https://*/*",
    "http://*/*"
  ],
  "background": {
    "service_worker": "worker.mjs",
    "type": "module"
  },
  "action": {
    "default_title": "打开 Diao",
    "default_icon": {
      "16": "icons/icon-16.png",
      "32": "icons/icon-32.png"
    }
  },
  "side_panel": {
    "default_path": "sidepanel.html"
  },
  "options_page": "sidepanel.html",
  "content_security_policy": {
    "extension_pages": "script-src 'self'; object-src 'none'; base-uri 'none'"
  },
  "icons": {
    "16": "icons/icon-16.png",
    "32": "icons/icon-32.png",
    "48": "icons/icon-48.png",
    "128": "icons/icon-128.png"
  }
}
