{
  "manifest_version": 3,
  "name": "Tab Cadence",
  "version": "0.1",
  "description": "右键监听网页任务，在标签旁接手；在 ChatGPT 原位批注、浏览大纲并排队续发。",
  "minimum_chrome_version": "120",
  "permissions": [
    "tabs",
    "storage",
    "sidePanel",
    "scripting",
    "activeTab",
    "alarms",
    "nativeMessaging",
    "tabGroups",
    "contextMenus"
  ],
  "optional_host_permissions": [
    "https://*/*",
    "http://*/*"
  ],
  "background": {
    "service_worker": "worker.mjs",
    "type": "module"
  },
  "action": {
    "default_title": "打开 Tab Cadence",
    "default_icon": {
      "16": "icons/icon-16.png",
      "32": "icons/icon-32.png"
    }
  },
  "side_panel": {
    "default_path": "sidepanel.html"
  },
  "options_page": "sidepanel.html",
  "content_security_policy": {
    "extension_pages": "script-src 'self'; object-src 'none'; base-uri 'none'"
  },
  "icons": {
    "16": "icons/icon-16.png",
    "32": "icons/icon-32.png",
    "48": "icons/icon-48.png",
    "128": "icons/icon-128.png"
  }
}
